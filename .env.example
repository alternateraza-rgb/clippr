# Copy to .env.local (Vercel + local app)

LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
YOUTUBE_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

CRON_SECRET=
CLIP_WORKER_URL=
CLIP_WORKER_SECRET=
SUPADATA_API_KEY=
APIFY_TOKEN=

ENABLE_LOCAL_EXPORT=false
CLIPMUSE_MODE=live

# Worker (your PC, or Render) also needs:
# SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# LLM_API_KEY or OPENAI_API_KEY  (Whisper + optional chat)
# CLIP_WORKER_SECRET             (must match Vercel)
# SUPADATA_API_KEY               (optional on worker; Vercel should have it)
# APIFY_TOKEN                    (YouTube file download — set this on Render)
# PORT=8787                      (Render sets this; local default is 8787)
