# Copy to .env.local (Vercel + local app)

LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
YOUTUBE_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

CRON_SECRET=
CLIP_WORKER_URL=
CLIP_WORKER_SECRET=
SUPADATA_API_KEY=
APIFY_TOKEN=

ENABLE_LOCAL_EXPORT=false
CLIPMUSE_MODE=live

# Worker (your PC, or Render) also needs:
# SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# LLM_API_KEY or OPENAI_API_KEY  (Whisper + optional chat)
# CLIP_WORKER_SECRET             (must match Vercel)
# SUPADATA_API_KEY               (optional on worker; Vercel should have it)
# APIFY_TOKEN                    (YouTube file download — set this on Render)
# YTDLP_PROXY                    (optional; http/https/socks5 URL of a RESIDENTIAL proxy,
#                                  credentials inline. Fixes "HTTP Error 403: Forbidden"
#                                  without cookies — YouTube blocks datacenter IPs, not
#                                  the request itself. Setting this makes the worker
#                                  download with yt-dlp first and only fall back to Apify.)
# YTDLP_FIRST=true               (optional; force yt-dlp before Apify with no proxy. Only
#                                  correct on a home machine — see docs/LOCAL_WORKER.md.)
# YTDLP_PLAYER_CLIENT            (optional; default "tv,web_safari,default". Override only
#                                  if YouTube breaks a client — the web client alone
#                                  triggers "Sign in to confirm you're not a bot".)
# YOUTUBE_COOKIES_TEXT           (optional; Netscape-format cookies exported with a
#                                  "Get cookies.txt LOCALLY" style extension. Needed only
#                                  for age-restricted videos, NOT for plain 403s.)
# PORT=8787                      (Render sets this; local default is 8787)
